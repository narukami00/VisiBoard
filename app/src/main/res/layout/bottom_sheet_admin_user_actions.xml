<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Manage User"
        android:textColor="@color/text_secondary"
        android:fontFamily="@font/poppins_semibold"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:id="@+id/action_warn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Warn User"
        android:textColor="@color/warning"
        android:textSize="16sp"
        android:fontFamily="@font/poppins_medium"
        android:padding="14dp"
        android:background="?attr/selectableItemBackground"/>

    <TextView
        android:id="@+id/action_restrict"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Restrict Account"
        android:textColor="@color/like_color"
        android:textSize="16sp"
        android:fontFamily="@font/poppins_medium"
        android:padding="14dp"
        android:background="?attr/selectableItemBackground"/>

    <TextView
        android:id="@+id/action_ban"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ban User"
        android:textColor="@color/error"
        android:textSize="16sp"
        android:fontFamily="@font/poppins_medium"
        android:padding="14dp"
        android:background="?attr/selectableItemBackground"/>

</LinearLayout>
