<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/swipe_refresh_notifications"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <Button
                android:id="@+id/btn_clear_notifications_tab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="8dp"
                android:text="Clear All"
                android:textColor="@color/primary"
                android:background="?attr/selectableItemBackgroundBorderless"
                style="?attr/borderlessButtonStyle"
                android:visibility="gone"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_notifications_tab"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>
        </LinearLayout>

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmer_view_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <include layout="@layout/item_notification_skeleton" />
                <include layout="@layout/item_notification_skeleton" />
                <include layout="@layout/item_notification_skeleton" />
                <include layout="@layout/item_notification_skeleton" />
                <include layout="@layout/item_notification_skeleton" />
                <include layout="@layout/item_notification_skeleton" />
                <include layout="@layout/item_notification_skeleton" />
            </LinearLayout>
        </com.facebook.shimmer.ShimmerFrameLayout>

        <TextView
            android:id="@+id/tv_no_notifications_tab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="You have no notification"
            android:textColor="@color/text_secondary"
            android:visibility="gone"/>

        <!-- ProgressBar removed as Shimmer is used -->

    </FrameLayout>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
