<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="60dp"
    android:paddingEnd="8dp"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/card_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="220dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/primary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="10dp"
            android:minWidth="220dp">

            <!-- Voice Message Controls -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Play/Pause Button with modern glass effect -->
                <ImageButton
                    android:id="@+id/btn_play"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_play"
                    android:background="@drawable/bg_circle_glass"
                    android:backgroundTint="#50FFFFFF"
                    android:tint="@color/white"
                    android:scaleType="centerInside"
                    android:padding="12dp"
                    android:contentDescription="Play" />

                <!-- Waveform/Progress with improved spacing -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <!-- Modern Progress Bar -->
                    <ProgressBar
                        android:id="@+id/progress_playback"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:max="100"
                        android:progress="0"
                        android:progressTint="@color/white"
                        android:progressBackgroundTint="#30FFFFFF"
                        android:progressDrawable="@drawable/progress_rounded" />

                    <!-- Duration with better styling -->
                    <TextView
                        android:id="@+id/tv_duration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0:00"
                        android:textColor="#E6FFFFFF"
                        android:textSize="12sp"
                        android:fontFamily="@font/poppins_medium"
                        android:layout_marginTop="4dp"
                        android:letterSpacing="0.02" />

                </LinearLayout>

            </LinearLayout>

            <!-- Time Row with modern styling -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end|center_vertical"
                android:layout_marginTop="6dp">

                <TextView
                    android:id="@+id/tv_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12:30 PM"
                    android:textColor="#AAFFFFFF"
                    android:textSize="10sp"
                    android:fontFamily="@font/poppins_regular" />

                <ImageView
                    android:id="@+id/iv_read_status"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/ic_check_double"
                    android:tint="#AAFFFFFF"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_reactions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="-8dp"
        app:layout_constraintEnd_toEndOf="@id/card_message"
        app:layout_constraintTop_toBottomOf="@id/card_message"
        android:elevation="4dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:clipToPadding="false"/>

</androidx.constraintlayout.widget.ConstraintLayout>
