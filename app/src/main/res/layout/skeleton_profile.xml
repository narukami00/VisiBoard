<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:shimmer_auto_start="true"
    app:shimmer_base_alpha="1.0"
    app:shimmer_highlight_alpha="1.0"
    app:shimmer_duration="1200"
    app:shimmer_direction="left_to_right"
    android:background="@color/background_light">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="40dp">

            <!-- Header Skeleton -->
            <View
                android:id="@+id/header_background"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:background="@drawable/bg_shimmer_card"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Profile Pic Skeleton -->
            <View
                android:id="@+id/profileImage"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:background="@drawable/bg_shimmer_circle"
                android:elevation="8dp"
                app:layout_constraintTop_toBottomOf="@id/header_background"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="@id/header_background"
                android:layout_marginTop="-60dp" />

            <!-- Name Skeleton -->
            <View
                android:layout_width="150dp"
                android:layout_height="24dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_shimmer_rounded"
                app:layout_constraintTop_toBottomOf="@id/profileImage"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Email Skeleton -->
            <View
                android:layout_width="200dp"
                android:layout_height="16dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_shimmer_rounded"
                app:layout_constraintTop_toBottomOf="@id/profileImage"
                app:layout_goneMarginTop="50dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Location Skeleton -->
            <View
                android:layout_width="120dp"
                android:layout_height="14dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_shimmer_rounded"
                app:layout_constraintTop_toBottomOf="@id/profileImage"
                app:layout_goneMarginTop="70dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Bio Skeleton -->
            <View
                android:layout_width="0dp"
                android:layout_height="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="32dp"
                android:background="@drawable/bg_shimmer_rounded"
                app:layout_constraintTop_toBottomOf="@id/profileImage"
                app:layout_goneMarginTop="90dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Stats Skeleton -->
            <LinearLayout
                android:id="@+id/stats_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="24dp"
                android:paddingBottom="24dp"
                app:layout_constraintTop_toBottomOf="@id/profileImage"
                app:layout_goneMarginTop="120dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Notes Stat -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <View
                        android:layout_width="40dp"
                        android:layout_height="20dp"
                        android:background="@drawable/bg_shimmer_rounded"
                        android:layout_marginBottom="4dp" />
                    <View
                        android:layout_width="50dp"
                        android:layout_height="12dp"
                        android:background="@drawable/bg_shimmer_rounded" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="30dp"
                    android:background="@color/divider"
                    android:layout_gravity="center_vertical" />

                <!-- Likes Stat -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <View
                        android:layout_width="40dp"
                        android:layout_height="20dp"
                        android:background="@drawable/bg_shimmer_rounded"
                        android:layout_marginBottom="4dp" />
                    <View
                        android:layout_width="50dp"
                        android:layout_height="12dp"
                        android:background="@drawable/bg_shimmer_rounded" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="30dp"
                    android:background="@color/divider"
                    android:layout_gravity="center_vertical" />

                <!-- Followers Stat -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <View
                        android:layout_width="30dp"
                        android:layout_height="20dp"
                        android:background="@drawable/bg_shimmer_rounded"
                        android:layout_marginBottom="4dp" />
                    <View
                        android:layout_width="60dp"
                        android:layout_height="12dp"
                        android:background="@drawable/bg_shimmer_rounded" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="30dp"
                    android:background="@color/divider"
                    android:layout_gravity="center_vertical" />

                <!-- Following Stat -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <View
                        android:layout_width="30dp"
                        android:layout_height="20dp"
                        android:background="@drawable/bg_shimmer_rounded"
                        android:layout_marginBottom="4dp" />
                    <View
                        android:layout_width="60dp"
                        android:layout_height="12dp"
                        android:background="@drawable/bg_shimmer_rounded" />
                </LinearLayout>
            </LinearLayout>

            <!-- Rank Card Skeleton -->
            <androidx.cardview.widget.CardView
                android:id="@+id/milestone_card_skeleton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@color/card_background"
                app:layout_constraintTop_toBottomOf="@id/stats_container"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                    <!-- Tier Icon Skeleton -->
                    <View
                        android:id="@+id/tier_icon_skeleton"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:background="@drawable/bg_shimmer_circle"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true" />

                    <!-- Tier Info Skeleton -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@+id/tier_icon_skeleton"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical">

                        <!-- "Current Rank" Label -->
                        <View
                            android:layout_width="80dp"
                            android:layout_height="12dp"
                            android:background="@drawable/bg_shimmer_rounded"
                            android:layout_marginBottom="4dp" />

                        <!-- Tier Name -->
                        <View
                            android:layout_width="120dp"
                            android:layout_height="18dp"
                            android:background="@drawable/bg_shimmer_rounded"
                            android:layout_marginBottom="8dp" />

                        <!-- Progress Bar Skeleton -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:background="@drawable/bg_shimmer_rounded"
                            android:layout_marginBottom="4dp" />

                        <!-- Progress Text -->
                        <View
                            android:layout_width="140dp"
                            android:layout_height="11dp"
                            android:background="@drawable/bg_shimmer_rounded" />
                    </LinearLayout>
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- Recent Notes Header Skeleton -->
            <View
                android:layout_width="120dp"
                android:layout_height="18dp"
                android:layout_marginStart="24dp"
                android:layout_marginTop="32dp"
                android:background="@drawable/bg_shimmer_rounded"
                app:layout_constraintTop_toBottomOf="@id/milestone_card_skeleton"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Recent Notes Items Skeleton -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="16dp"
                android:paddingBottom="24dp"
                app:layout_constraintTop_toBottomOf="@id/milestone_card_skeleton"
                app:layout_goneMarginTop="60dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Note Item 1 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/card_background">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="100dp"
                            android:background="@drawable/bg_shimmer_card"
                            android:layout_marginBottom="12dp" />
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="14dp"
                            android:background="@drawable/bg_shimmer_rounded"
                            android:layout_marginBottom="6dp" />
                        <View
                            android:layout_width="200dp"
                            android:layout_height="14dp"
                            android:background="@drawable/bg_shimmer_rounded" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Note Item 2 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/card_background">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="80dp"
                            android:background="@drawable/bg_shimmer_card"
                            android:layout_marginBottom="12dp" />
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="14dp"
                            android:background="@drawable/bg_shimmer_rounded"
                            android:layout_marginBottom="6dp" />
                        <View
                            android:layout_width="180dp"
                            android:layout_height="14dp"
                            android:background="@drawable/bg_shimmer_rounded" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</com.facebook.shimmer.ShimmerFrameLayout>
