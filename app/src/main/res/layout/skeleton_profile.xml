<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="40dp">

        <!-- Header -->
        <View
            android:id="@+id/header_background"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:background="#E0E0E0"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Profile Pic Skeleton -->
        <View
            android:id="@+id/profileImage"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:background="@drawable/bg_radar_circle"
            android:backgroundTint="#E0E0E0"
            android:elevation="8dp"
            app:layout_constraintTop_toBottomOf="@id/header_background"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/header_background" />

        <!-- Name Skeleton -->
        <View
            android:layout_width="150dp"
            android:layout_height="24dp"
            android:layout_marginTop="16dp"
            android:background="#E0E0E0"
            app:layout_constraintTop_toBottomOf="@id/profileImage"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Email Skeleton -->
        <View
            android:layout_width="200dp"
            android:layout_height="16dp"
            android:layout_marginTop="8dp"
            android:background="#E0E0E0"
            app:layout_constraintTop_toBottomOf="@+id/profileImage"
            app:layout_goneMarginTop="50dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Stats Skeleton -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="24dp">
        
        <View android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:background="#E0E0E0" android:layout_margin="4dp"/>
        <View android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:background="#E0E0E0" android:layout_margin="4dp"/>
        <View android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:background="#E0E0E0" android:layout_margin="4dp"/>
    </LinearLayout>

    <!-- Card Skeleton -->
    <View
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_margin="24dp"
        android:background="@drawable/bg_rounded_tile"
        android:backgroundTint="#E0E0E0" />

</LinearLayout>
