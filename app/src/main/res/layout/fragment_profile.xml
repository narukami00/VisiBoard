<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipeRefreshLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="40dp">

            <!-- Header Physics Container -->
    <com.visiboard.app.ui.profile.FloatingPhysicsLayout
        android:id="@+id/physics_header_container"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="@color/color_primary_light"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

            <!-- Pattern Overlay (Optional, using alpha) -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:src="@drawable/ic_pattern_circle"
                android:scaleType="centerCrop"
                android:alpha="0.1"
                app:tint="#FFFFFF"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" 
                tools:ignore="ContentDescription" />

            <!-- Top Icons (Map, Theme, Logout) -->
            <ImageView
                android:id="@+id/btn_view_all_notes"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_map"
                android:padding="8dp"
                android:background="@drawable/bg_circle_glass"
                android:backgroundTint="#20FFFFFF"
                app:tint="#FFFFFF"
                android:layout_margin="16dp"
                android:elevation="4dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:contentDescription="View Map" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_margin="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">



                <ImageView
                    android:id="@+id/theme_toggle_icon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_moon"
                    android:padding="8dp"
                    android:background="@drawable/bg_circle_glass"
                    android:backgroundTint="#20FFFFFF"
                    app:tint="#FFFFFF"
                    android:layout_marginEnd="8dp"
                    android:elevation="4dp"
                    android:contentDescription="Toggle Theme" />




                <ImageView
                    android:id="@+id/settings_icon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_settings"
                    android:padding="8dp"
                    android:background="@drawable/bg_circle_glass"
                    android:backgroundTint="#20FFFFFF"
                    app:tint="#FFFFFF"
                    android:elevation="4dp"
                    android:contentDescription="Settings" />
            </LinearLayout>

            <!-- 2. Profile Picture (Overlapping) -->
            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/profileImage"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/ic_profile"
                app:civ_border_width="4dp"
                app:civ_border_color="@color/card_background"
                android:elevation="8dp"
                app:layout_constraintTop_toBottomOf="@id/physics_header_container"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="-60dp" />

             <!-- Camera Badge for Profile Pic -->
            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_camera_alt"
                android:padding="6dp"
                android:background="@drawable/bg_circle_primary"
                app:tint="@color/white"
                android:elevation="9dp"
                app:layout_constraintBottom_toBottomOf="@id/profileImage"
                app:layout_constraintEnd_toEndOf="@id/profileImage"
                android:layout_marginBottom="4dp"
                android:layout_marginEnd="4dp" />

            <!-- 3. User Info -->
            <TextView
                android:id="@+id/profileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="User Name"
                android:textSize="22sp"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:fontFamily="@font/poppins_semibold"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/profileImage"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Joined Date -->
            <TextView
                android:id="@+id/tv_joined_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/text_tertiary"
                android:fontFamily="@font/poppins_regular"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/profileName"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <LinearLayout
                android:id="@+id/location_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp"
                app:layout_constraintTop_toBottomOf="@id/tv_joined_date"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_my_location"
                    app:tint="@color/text_tertiary"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/tv_location"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Location"
                    android:textSize="13sp"
                    android:textColor="@color/text_tertiary"
                    android:fontFamily="@font/poppins_regular"
                    android:visibility="visible" />
            </LinearLayout>

            <!-- Bio Section -->
            <TextView
                android:id="@+id/tv_bio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Tap to add bio..."
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:fontFamily="@font/poppins_regular"
                android:gravity="center"
                android:layout_marginTop="12dp"
                android:layout_marginHorizontal="32dp"
                app:layout_constraintTop_toBottomOf="@id/location_container"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Details Section -->
            <LinearLayout
                android:id="@+id/ll_details_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="32dp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/tv_bio"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">
                
                <!-- Work -->
                <LinearLayout
                    android:id="@+id/row_work"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone">
                    <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_work" app:tint="@color/text_tertiary" android:layout_marginEnd="8dp"/>
                    <TextView android:id="@+id/tv_work" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Works at..." android:textColor="@color/text_primary" android:textSize="13sp"/>
                </LinearLayout>

                <!-- Education -->
                <LinearLayout
                    android:id="@+id/row_education"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone">
                    <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_school" app:tint="@color/text_tertiary" android:layout_marginEnd="8dp"/>
                    <TextView android:id="@+id/tv_education" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Studied at..." android:textColor="@color/text_primary" android:textSize="13sp"/>
                </LinearLayout>

                <!-- Relationship -->
                <LinearLayout
                    android:id="@+id/row_relationship"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone">
                    <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_heart" app:tint="@color/text_tertiary" android:layout_marginEnd="8dp"/>
                    <TextView android:id="@+id/tv_relationship" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Single" android:textColor="@color/text_primary" android:textSize="13sp"/>
                </LinearLayout>

                <!-- Hometown -->
                <LinearLayout
                    android:id="@+id/row_hometown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone">
                    <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_home" app:tint="@color/text_tertiary" android:layout_marginEnd="8dp"/>
                    <TextView android:id="@+id/tv_hometown" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="From..." android:textColor="@color/text_primary" android:textSize="13sp"/>
                </LinearLayout>

                <!-- Birthday -->
                <LinearLayout
                    android:id="@+id/row_birthday"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone">
                    <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_cake" app:tint="@color/text_tertiary" android:layout_marginEnd="8dp"/>
                    <TextView android:id="@+id/tv_birthday" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Birthday..." android:textColor="@color/text_primary" android:textSize="13sp"/>
                </LinearLayout>
                
                <!-- Email Row (moved here) -->
                <LinearLayout
                    android:id="@+id/row_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">
                    <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_email" app:tint="@color/text_tertiary" android:layout_marginEnd="8dp"/>
                    <TextView android:id="@+id/profileEmail" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="user@example.com" android:textColor="@color/text_primary" android:textSize="13sp"/>
                </LinearLayout>
                
                <TextView
                     android:id="@+id/btn_edit_details"
                     android:layout_width="match_parent"
                     android:layout_height="wrap_content"
                     android:text="Edit Public Details"
                     android:textColor="@color/primary"
                     android:background="@drawable/bg_button_outline_small"
                     android:gravity="center"
                     android:padding="8dp"
                     android:textSize="12sp"
                     android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Links Section -->
            <HorizontalScrollView
                android:id="@+id/sv_links"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:paddingHorizontal="24dp"
                android:clipToPadding="false"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/ll_details_container">
                
                <LinearLayout
                    android:id="@+id/ll_links_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    
                    <!-- Add Link Button -->
                    <LinearLayout
                        android:id="@+id/btn_add_link"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_capsule_outline"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:gravity="center"
                        android:layout_marginEnd="8dp">
                        <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_add" app:tint="@color/primary" android:layout_marginEnd="4dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Add Link" android:textColor="@color/primary" android:textSize="12sp" android:textStyle="bold"/>
                    </LinearLayout>
                    
                    <!-- Dynamic links will be added here -->

                </LinearLayout>
            </HorizontalScrollView>

            <!-- 4. Stats Row (Followers/Following/Notes) -->
            <LinearLayout
                android:id="@+id/stats_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="24dp"
                android:paddingBottom="24dp"
                android:baselineAligned="false"
                app:layout_constraintTop_toBottomOf="@id/sv_links">

                <!-- Notes -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:id="@+id/tv_total_notes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary"
                        android:fontFamily="@font/poppins_semibold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Notes"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:fontFamily="@font/poppins_regular" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="30dp"
                    android:background="@color/divider"
                    android:layout_gravity="center_vertical" />

                <!-- Likes -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:id="@+id/tv_total_likes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary"
                        android:fontFamily="@font/poppins_semibold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Likes"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:fontFamily="@font/poppins_regular" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="30dp"
                    android:background="@color/divider"
                    android:layout_gravity="center_vertical" />

                <!-- Followers -->
                <LinearLayout
                    android:id="@+id/followers_section"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:id="@+id/tv_followers_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary"
                        android:fontFamily="@font/poppins_semibold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Followers"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:fontFamily="@font/poppins_regular" />
                </LinearLayout>
                
                <View
                    android:layout_width="1dp"
                    android:layout_height="30dp"
                    android:background="@color/divider"
                    android:layout_gravity="center_vertical" />

                <!-- Following -->
                <LinearLayout
                    android:id="@+id/following_section"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:id="@+id/tv_following_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary"
                        android:fontFamily="@font/poppins_semibold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Following"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:fontFamily="@font/poppins_regular" />
                </LinearLayout>
            </LinearLayout>

            <!-- 5. Hero Tier Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/milestone_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@color/card_background"
                app:layout_constraintTop_toBottomOf="@id/stats_container">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">
                    
                    <!-- Background Pattern -->
                    
                    <ImageView
                        android:id="@+id/iv_tier_icon"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:src="@drawable/ic_default_tier"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true" />
                        
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@id/iv_tier_icon"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical">
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Current Rank"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:fontFamily="@font/poppins_regular" />
                            
                        <TextView
                            android:id="@+id/tv_milestone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Silver Tier"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/primaryDark"
                            android:fontFamily="@font/poppins_semibold" />
                            
                        <ProgressBar
                            android:id="@+id/progress_milestone"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:layout_marginTop="8dp"
                            android:progressDrawable="@drawable/custom_progress_drawable" 
                            android:progressTint="@color/primary"
                            android:max="100"
                            android:progress="50" />
                            
                        <TextView
                            android:id="@+id/tv_milestone_progress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="250 / 500 Likes"
                            android:textSize="11sp"
                            android:textColor="@color/text_tertiary" />
                    </LinearLayout>
                   
                    <TextView
                        android:id="@+id/tv_card_likes_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentEnd="true"
                        android:text="0 Likes"
                        android:textSize="12sp"
                        android:textColor="@color/primary"
                        android:background="@drawable/bg_capsule_light"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:visibility="gone"/>

                </RelativeLayout>
                
                <!-- Shine Effect Overlay -->
                <ImageView
                    android:id="@+id/shine_view"
                    android:layout_width="100dp"
                    android:layout_height="match_parent"
                    android:src="@drawable/bg_shine_gradient"
                    android:rotation="20"
                    android:translationX="-200dp"
                    android:alpha="0.3"
                    android:layout_gravity="center_vertical"/>
                    
            </androidx.cardview.widget.CardView>

            <!-- 6. Recent Notes Section -->
            <TextView
                android:id="@+id/tv_recent_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recent Updates"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:fontFamily="@font/poppins_semibold"
                android:layout_marginStart="24dp"
                android:layout_marginTop="32dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/milestone_card" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_recent_notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clipToPadding="false"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingBottom="24dp"
                android:nestedScrollingEnabled="false"
                app:layout_constraintTop_toBottomOf="@id/tv_recent_header"
                app:layout_constraintBottom_toBottomOf="parent" />

            <TextView
                android:id="@+id/tv_no_recent_notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No recent activity to show"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:fontFamily="@font/poppins_regular"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/tv_recent_header"
                app:layout_constraintBottom_toBottomOf="parent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_create_first_note"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Create your first note"
                android:textColor="@color/white"
                app:backgroundTint="@color/primary"
                app:cornerRadius="20dp"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/tv_no_recent_notes"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <!-- Skeleton Loading View (Wrapped for Elevation) -->
            <FrameLayout
                android:id="@+id/skeleton_view"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@color/background_light"
                android:elevation="20dp"
                android:visibility="visible"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">
                
                <include 
                    layout="@layout/skeleton_profile"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </FrameLayout>

            <!-- Loading Overlay (Keep as backup or remove if skeleton is sufficient) -->
            <FrameLayout
                android:id="@+id/loading_overlay"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:background="@color/background_light"
                android:elevation="10dp"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ProgressBar
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/primary"
                    android:scaleX="1.5"
                    android:scaleY="1.5"/>
            </FrameLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
