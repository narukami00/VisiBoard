<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    android:layout_margin="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center"
        android:background="@color/fidget_spinner_bg">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Give it a spin!"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/fidget_text_secondary"
            android:layout_marginBottom="16dp"/>

        <ImageView
            android:id="@+id/iv_fidget_spinner"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:contentDescription="Fidget Spinner"
            android:src="@drawable/ic_fidget_spinner" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
