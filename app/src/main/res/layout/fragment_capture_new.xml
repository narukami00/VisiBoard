<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <!-- Camera Preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/camera_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Overlay for AR notes -->
    <FrameLayout
        android:id="@+id/ar_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Info Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="top"
        android:background="@drawable/bg_gradient_top"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_ar_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AR View"
            android:textColor="@color/text_on_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="@font/poppins_semibold"
            android:layout_gravity="center" />

        <TextView
            android:id="@+id/tv_notes_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Searching for nearby notes..."
            android:textColor="@color/text_on_primary"
            android:textSize="14sp"
            android:fontFamily="@font/poppins_regular"
            android:layout_gravity="center"
            android:layout_marginTop="4dp" />

    </LinearLayout>

    <!-- Bottom Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/bg_gradient_bottom"
        android:padding="24dp"
        android:gravity="center">

        <!-- Range Indicator -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_range_indicator"
            android:padding="12dp"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_radar"
                app:tint="@color/accent" />

            <TextView
                android:id="@+id/tv_range"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10m radius"
                android:textColor="@color/text_on_primary"
                android:textSize="14sp"
                android:fontFamily="@font/poppins_medium"
                android:layout_marginStart="8dp" />

        </LinearLayout>

        <!-- Help Text -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Move your device around to see notes"
            android:textColor="@color/text_on_primary"
            android:textSize="12sp"
            android:alpha="0.8"
            android:fontFamily="@font/poppins_regular" />

    </LinearLayout>

    <!-- Loading Indicator -->
    <ProgressBar
        android:id="@+id/progress_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/primary"
        android:visibility="gone" />

</FrameLayout>
