<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@color/card_background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/iv_user_avatar"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_profile"
            app:civ_border_width="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <ImageView
            android:id="@+id/iv_notification_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:background="@drawable/bg_badge_transparent"
            android:padding="2dp"
            android:src="@drawable/ic_like"
            app:tint="@color/primary"
            app:layout_constraintBottom_toBottomOf="@id/iv_user_avatar"
            app:layout_constraintEnd_toEndOf="@id/iv_user_avatar"/>

        <TextView
            android:id="@+id/tv_notification_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:text="User liked your note"
            app:layout_constraintStart_toEndOf="@id/iv_user_avatar"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/view_unread_indicator"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintBottom_toTopOf="@id/tv_notification_time"/>

        <TextView
            android:id="@+id/tv_notification_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            android:text="2 hours ago"
            app:layout_constraintStart_toEndOf="@id/iv_user_avatar"
            app:layout_constraintTop_toBottomOf="@id/tv_notification_text"
            app:layout_constraintEnd_toStartOf="@id/view_unread_indicator"
            app:layout_constraintBottom_toTopOf="@id/btn_reply"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_reply"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginTop="8dp"
            android:layout_marginStart="16dp"
            android:text="Reply"
            android:textSize="12sp"
            android:paddingHorizontal="16dp"
            android:visibility="gone"
            app:cornerRadius="18dp"
            app:strokeColor="@color/primary"
            app:strokeWidth="1dp"
            android:textColor="@color/primary"
            app:layout_constraintStart_toEndOf="@id/iv_user_avatar"
            app:layout_constraintTop_toBottomOf="@id/tv_notification_time"
            app:layout_constraintBottom_toBottomOf="parent" />

        <View
            android:id="@+id/view_unread_indicator"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/bg_badge_transparent"
            android:backgroundTint="@color/primary"
            android:visibility="visible"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
