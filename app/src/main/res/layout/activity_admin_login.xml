<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:padding="24dp">

    <TextView
        android:id="@+id/adminTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Admin Access"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@android:color/holo_red_light"
        android:fontFamily="@font/poppins_bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="80dp" />

    <EditText
        android:id="@+id/adminIdInput"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:hint="Admin ID"
        android:textColorHint="@color/text_hint"
        android:textColor="@android:color/white"
        android:background="@drawable/edittext_bg"
        android:backgroundTint="#333333"
        android:padding="16dp"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/adminTitle" />

    <EditText
        android:id="@+id/adminPassInput"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:hint="Passcode"
        android:inputType="textPassword"
        android:textColorHint="@color/text_hint"
        android:textColor="@android:color/white"
        android:background="@drawable/edittext_bg"
        android:backgroundTint="#333333"
        android:padding="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/adminIdInput" />

    <Button
        android:id="@+id/adminLoginBtn"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="ACCESS"
        android:backgroundTint="@android:color/holo_red_dark"
        android:textColor="@android:color/white"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/adminPassInput" />

</androidx.constraintlayout.widget.ConstraintLayout>
