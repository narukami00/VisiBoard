<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardElevation="6dp"
    android:layout_margin="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#FAFAFA"
        android:gravity="center_horizontal">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">
            
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Pixel Art"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#424242"/>
                
            <ImageView
                android:id="@+id/btn_shuffle"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_shuffle_fidget"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="Shuffle"/>
                
            <ImageView
                android:id="@+id/btn_reset"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_refresh_fidget"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:contentDescription="Reset"/>
        </LinearLayout>

        <GridLayout
            android:id="@+id/gl_tiles"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:columnCount="4"
            android:rowCount="3">

            <!-- 12 Rounded Tiles -->
            <View android:layout_width="48dp" android:layout_height="48dp" android:layout_margin="6dp" android:background="@drawable/bg_rounded_tile" />
            <View android:layout_width="48dp" android:layout_height="48dp" android:layout_margin="6dp" android:background="@drawable/bg_rounded_tile" />
            <View android:layout_width="48dp" android:layout_height="48dp" android:layout_margin="6dp" android:background="@drawable/bg_rounded_tile" />
            <View android:layout_width="48dp" android:layout_height="48dp" android:layout_margin="6dp" android:background="@drawable/bg_rounded_tile" />
            
            <View android:layout_width="48dp" android:layout_height="48dp" android:layout_margin="6dp" android:background="@drawable/bg_rounded_tile" />
            <View android:layout_width="48dp" android:layout_height="48dp" android:layout_margin="6dp" android:background="@drawable/bg_rounded_tile" />
            <View android:layout_width="48dp" android:layout_height="48dp" android:layout_margin="6dp" android:background="@drawable/bg_rounded_tile" />
            <View android:layout_width="48dp" android:layout_height="48dp" android:layout_margin="6dp" android:background="@drawable/bg_rounded_tile" />
            
            <View android:layout_width="48dp" android:layout_height="48dp" android:layout_margin="6dp" android:background="@drawable/bg_rounded_tile" />
            <View android:layout_width="48dp" android:layout_height="48dp" android:layout_margin="6dp" android:background="@drawable/bg_rounded_tile" />
            <View android:layout_width="48dp" android:layout_height="48dp" android:layout_margin="6dp" android:background="@drawable/bg_rounded_tile" />
            <View android:layout_width="48dp" android:layout_height="48dp" android:layout_margin="6dp" android:background="@drawable/bg_rounded_tile" />

        </GridLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
