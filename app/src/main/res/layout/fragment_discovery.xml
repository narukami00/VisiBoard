<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/et_search"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search_bar"
            android:hint="Search users..."
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="8dp"
            android:maxLines="1"
            android:inputType="textPersonName"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"/>

        <ImageButton
            android:id="@+id/btn_view_mode"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_grid" 
            android:contentDescription="Toggle View Mode"
            app:tint="?android:attr/textColorPrimary"/>

    </LinearLayout>

    <!-- Main Content Wrapper -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Shimmer View -->
        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmer_view_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">
            
            <include layout="@layout/layout_shimmer_discovery" />
            
        </com.facebook.shimmer.ShimmerFrameLayout>

        <!-- Data Content -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_discovery"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="16dp"
            android:visibility="gone"/>

        <!-- Empty State for "You follow everyone" -->
        <TextView
            android:id="@+id/tv_empty_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="You follow everyone! 🎉\n\nNo new people to discover right now."
            android:textSize="16sp"
            android:textColor="@color/text_secondary"
            android:fontFamily="@font/poppins_regular"
            android:visibility="gone"/>

    </FrameLayout>

</LinearLayout>
