<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <!-- Camera Preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/camera_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Filter Overlay -->
    <View
        android:id="@+id/filter_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#00000000" />

    <!-- Overlay for ML Analysis (QR/OCR) -->
    <com.visiboard.app.ui.capture.GraphicOverlay
        android:id="@+id/graphic_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Overlay for AR notes -->
    <FrameLayout
        android:id="@+id/ar_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" >
    </FrameLayout>

    <!-- Step Counter Overlay (Moved to Top) -->
    <!-- Removed from here, will place inside Top Info Bar or just below it -->

    <!-- Top Info Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="top"
        android:background="@drawable/bg_gradient_top"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_centerInParent="true">

                <TextView
                    android:id="@+id/tv_ar_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AR View"
                    android:textColor="@color/text_on_primary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins_semibold"
                    android:layout_gravity="center"
                    android:shadowColor="#80000000"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="2" />

                <TextView
                    android:id="@+id/tv_notes_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Searching for nearby notes..."
                    android:textColor="@color/text_on_primary"
                    android:textSize="14sp"
                    android:fontFamily="@font/poppins_regular"
                    android:layout_gravity="center"
                    android:layout_marginTop="4dp"
                    android:shadowColor="#80000000"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="2" />
                    
                <!-- Zoom Indicator -->
                <LinearLayout
                    android:id="@+id/ll_zoom_indicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_zoom_indicator"
                    android:layout_gravity="center"
                    android:layout_marginTop="8dp"
                    android:visibility="gone">
                    
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_search"
                        android:tint="@color/white"
                        android:layout_marginEnd="6dp" />
                    
                    <TextView
                        android:id="@+id/tv_zoom_level"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1.0x"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppins_semibold" />
                </LinearLayout>
                    
                <TextView
                    android:id="@+id/tv_status_indicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Notes Hidden"
                    android:textColor="#FF5252"
                    android:textSize="14sp"
                    android:fontFamily="@font/poppins_bold"
                    android:layout_gravity="center"
                    android:layout_marginTop="2dp"
                    android:visibility="gone"
                    android:shadowColor="#80000000"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="2" />
                    
                 <LinearLayout
                    android:id="@+id/ll_step_counter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_capsule_dark"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="8dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_steps"
                        app:tint="#4CAF50" />

                    <TextView
                        android:id="@+id/tv_step_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 Steps"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:fontFamily="@font/poppins_medium"
                        android:layout_marginStart="8dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Menu Button (Top Left) -->
            <ImageButton
                android:id="@+id/btn_menu_toggle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_menu_white"
                android:scaleType="fitCenter"
                android:padding="8dp"
                android:contentDescription="Menu" />

            <com.visiboard.app.ui.capture.RadarView
                android:id="@+id/radar_view"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_radar_circle" />

        </RelativeLayout>

    </LinearLayout>

    <!-- Bottom Controls -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_gradient_bottom"
        android:padding="24dp">

        <!-- Camera Toggle Button (Bottom Left) -->
        <ImageButton
            android:id="@+id/btn_camera_toggle"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"
            android:background="@drawable/bg_camera_toggle_button"
            android:contentDescription="Toggle Camera"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_camera_flip"
            android:elevation="4dp"/>

        <!-- Capture Button (Bottom Center) -->
        <ImageButton
            android:id="@+id/btn_capture"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:background="@android:color/transparent"
            android:contentDescription="Capture Photo"
            android:elevation="6dp"
            android:scaleType="fitXY"
            android:src="@drawable/ic_capture"
            android:padding="0dp"/>

        <!-- Radius Selection Button (Bottom Right) -->
        <FrameLayout
            android:id="@+id/btn_radius"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_radius_button"
            android:clickable="true"
            android:focusable="true"
            android:elevation="4dp">

            <TextView
                android:id="@+id/tv_radius_value"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:fontFamily="@font/poppins_semibold"
                android:text="10"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

        </FrameLayout>

    </RelativeLayout>

    <!-- Menu Container (Staggered List) -->
    <LinearLayout
        android:id="@+id/ll_menu_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginTop="80dp"
        android:layout_marginStart="24dp"
        android:orientation="vertical"
        android:visibility="gone"
        android:clipToPadding="false"
        android:padding="8dp">

        <!-- Item 1: Reset Location -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_reset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#F21E272E">

            <LinearLayout
                android:id="@+id/item_reset_location"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_refresh"
                    app:tint="@color/text_light" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reset Location"
                    android:textColor="@color/text_light"
                    android:layout_marginStart="12dp"
                    android:textSize="13sp"
                    android:fontFamily="@font/poppins_medium" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Item 2: Hide/Show Notes -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_visibility"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="0dp"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#F21E272E">

            <LinearLayout
                android:id="@+id/item_toggle_visibility"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iv_menu_eye"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_eye_visible"
                    app:tint="@color/text_light" />

                <TextView

                    android:id="@+id/tv_menu_visibility"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hide Notes"
                    android:textColor="@color/text_light"
                    android:layout_marginStart="12dp"
                    android:textSize="13sp"
                    android:fontFamily="@font/poppins_medium" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Item 3: QR Mode -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_qr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#F21E272E"
            android:visibility="invisible">

            <LinearLayout
                android:id="@+id/item_qr_mode"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iv_menu_qr"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_qr_code"
                    app:tint="@color/text_light" />

                <TextView
                    android:id="@+id/tv_menu_qr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="QR Scanner"
                    android:textColor="@color/text_light"
                    android:layout_marginStart="12dp"
                    android:textSize="13sp"
                    android:fontFamily="@font/poppins_medium" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Item 4: OCR Scanner -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_ocr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#F21E272E"
            android:visibility="invisible">

            <LinearLayout
                android:id="@+id/item_ocr_mode"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iv_menu_ocr"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_text_fields"
                    app:tint="@color/text_light" />

                <TextView
                    android:id="@+id/tv_menu_ocr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Text Scanner"
                    android:textColor="@color/text_light"
                    android:layout_marginStart="12dp"
                    android:textSize="13sp"
                    android:fontFamily="@font/poppins_medium" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Item 5: Color Filter -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#F21E272E"
            android:visibility="invisible">

            <LinearLayout
                android:id="@+id/item_filter"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iv_menu_filter"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_palette"
                    app:tint="@color/text_light" />

                <TextView
                    android:id="@+id/tv_menu_filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Filter: Normal"
                    android:textColor="@color/text_light"
                    android:layout_marginStart="12dp"
                    android:textSize="13sp"
                    android:fontFamily="@font/poppins_medium" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Item 6: Flashlight -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_flash"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#F21E272E"
            android:visibility="invisible">

            <LinearLayout
                android:id="@+id/item_flash"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iv_menu_flash"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_flash_off"
                    app:tint="@color/text_light" />

                <TextView
                    android:id="@+id/tv_menu_flash"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Flashlight"
                    android:textColor="@color/text_light"
                    android:layout_marginStart="12dp"
                    android:textSize="13sp"
                    android:fontFamily="@font/poppins_medium" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Item 7: Steps Visibility -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_steps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="0dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#F21E272E"
            android:visibility="invisible">

            <LinearLayout
                android:id="@+id/item_steps"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iv_menu_steps"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_steps"
                    app:tint="@color/text_light" />

                <TextView
                    android:id="@+id/tv_menu_steps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Show Steps"
                    android:textColor="@color/text_light"
                    android:layout_marginStart="12dp"
                    android:textSize="13sp"
                    android:fontFamily="@font/poppins_medium" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- Loading Indicator -->
    <ProgressBar
        android:id="@+id/progress_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/primary"
        android:visibility="gone" />

</FrameLayout>
