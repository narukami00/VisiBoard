<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <!-- Camera Preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/camera_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Overlay for AR notes -->
    <FrameLayout
        android:id="@+id/ar_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Info Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="top"
        android:background="@drawable/bg_gradient_top"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_centerInParent="true">

                <TextView
                    android:id="@+id/tv_ar_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AR View"
                    android:textColor="@color/text_on_primary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins_semibold"
                    android:layout_gravity="center" />

                <TextView
                    android:id="@+id/tv_notes_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Searching for nearby notes..."
                    android:textColor="@color/text_on_primary"
                    android:textSize="14sp"
                    android:fontFamily="@font/poppins_regular"
                    android:layout_gravity="center"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <com.visiboard.app.ui.capture.RadarView
                android:id="@+id/radar_view"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_radar_circle" />

        </RelativeLayout>

    </LinearLayout>

    <!-- Bottom Controls -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_gradient_bottom"
        android:padding="24dp">

        <!-- Camera Toggle Button (Bottom Left) -->
        <ImageButton
            android:id="@+id/btn_camera_toggle"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"
            android:background="@drawable/bg_camera_toggle_button"
            android:contentDescription="Toggle Camera"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_camera_flip"
            android:elevation="4dp"/>

        <!-- Capture Button (Bottom Center) -->
        <ImageButton
            android:id="@+id/btn_capture"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:background="@android:color/transparent"
            android:contentDescription="Capture Photo"
            android:elevation="6dp"
            android:scaleType="fitXY"
            android:src="@drawable/ic_capture"
            android:padding="0dp"/>

        <!-- Radius Selection Button (Bottom Right) -->
        <FrameLayout
            android:id="@+id/btn_radius"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_radius_button"
            android:clickable="true"
            android:focusable="true"
            android:elevation="4dp">

            <TextView
                android:id="@+id/tv_radius_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="10"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins_semibold"/>

        </FrameLayout>

    </RelativeLayout>

    <!-- Loading Indicator -->
    <ProgressBar
        android:id="@+id/progress_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/primary"
        android:visibility="gone" />

</FrameLayout>
