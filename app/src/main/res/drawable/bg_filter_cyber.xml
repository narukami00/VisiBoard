<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Cyber Blue/Purple Tint -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:startColor="#4400E5FF"
                android:endColor="#44AA00FF"
                android:type="linear" />
        </shape>
    </item>
    
    <!-- Tech Grid Effect (Simulated via overlay) -->
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="2dp"
                android:color="#3300E5FF" />
            <solid android:color="#00000000" />
        </shape>
    </item>
    
    <!-- Center Glow -->
     <item android:top="100dp" android:bottom="100dp" android:left="50dp" android:right="50dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="400dp"
                android:startColor="#22FFFFFF"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
