<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base Green Tint -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#3300FF00" />
        </shape>
    </item>
    
    <!-- Vignette -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="800dp"
                android:startColor="#00000000"
                android:centerColor="#22000000"
                android:endColor="#99000000" />
        </shape>
    </item>

    <!-- Scanlines (Simple Stripe Pattern via Gradient) -->
    <!-- Note: True scanlines are hard in XML without a bitmap tile. 
         We'll simulate a subtle vertical gradient to give it texture -->
    <item>
         <shape>
            <gradient
                android:angle="90"
                android:startColor="#1100FF00"
                android:centerColor="#00000000"
                android:endColor="#1100FF00"
                android:type="linear"/>
        </shape>
    </item>
</layer-list>
