<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center_vertical"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_rank_item">

    <ImageView
        android:id="@+id/rank_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_bronze" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="16dp">

        <TextView
            android:id="@+id/rank_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bronze"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/primaryDark"
            android:fontFamily="@font/poppins_semibold" />

        <TextView
            android:id="@+id/rank_requirement"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="100 Likes Required"
            android:textSize="13sp"
            android:textColor="@color/secondary"
            android:fontFamily="@font/poppins_regular" />

    </LinearLayout>

    <ImageView
        android:id="@+id/rank_status"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_lock"
        android:tint="@color/secondary" />

</LinearLayout>
