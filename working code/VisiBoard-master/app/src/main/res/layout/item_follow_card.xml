<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_premium"
    android:padding="12dp"
    android:layout_marginBottom="8dp">

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/item_user_profile_pic"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_profile_placeholder"
        app:civ_border_width="1dp"
        app:civ_border_color="@color/divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/item_user_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:text="User Name"
        android:textSize="15sp"
        android:textColor="@color/text_primary"
        android:fontFamily="@font/poppins_semibold"
        app:layout_constraintStart_toEndOf="@id/item_user_profile_pic"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/item_user_location"
        app:layout_constraintEnd_toStartOf="@id/item_follow_btn"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/item_user_location"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:text="Location"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:fontFamily="@font/poppins_regular"
        android:visibility="gone"
        app:layout_constraintStart_toEndOf="@id/item_user_profile_pic"
        app:layout_constraintTop_toBottomOf="@id/item_user_name"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/item_follow_btn" />

    <Button
        android:id="@+id/item_follow_btn"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:text="Follow"
        android:textSize="12sp"
        android:textColor="@color/button_text_primary"
        android:background="@drawable/bg_button_gradient"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textAllCaps="false"
        android:fontFamily="@font/poppins_semibold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
