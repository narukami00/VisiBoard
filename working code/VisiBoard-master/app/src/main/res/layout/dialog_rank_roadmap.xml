<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="20dp"
    app:cardElevation="12dp"
    app:cardBackgroundColor="@color/card_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="600dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Header with Close Button -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ranking System"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/primaryDark"
                    android:fontFamily="@font/poppins_semibold"
                    android:layout_centerHorizontal="true" />

                <ImageButton
                    android:id="@+id/btn_close_ranking"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_alignParentEnd="true"
                    android:src="@drawable/ic_close"
                    android:background="@drawable/bg_circle_glass"
                    android:backgroundTint="#40000000"
                    app:tint="@color/white"
                    android:contentDescription="Close" />
            </RelativeLayout>

            <!-- Current Rank Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@color/primary">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Your Current Rank"
                        android:textSize="14sp"
                        android:textColor="@color/text_on_primary"
                        android:fontFamily="@font/poppins_regular"
                        android:layout_marginBottom="8dp" />

                    <ImageView
                        android:id="@+id/dialog_current_tier_icon"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:src="@drawable/ic_default_tier"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/dialog_current_tier_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="None"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_on_primary"
                        android:fontFamily="@font/poppins_semibold"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/dialog_current_likes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 Likes"
                        android:textSize="16sp"
                        android:textColor="@color/text_on_primary"
                        android:fontFamily="@font/poppins_regular" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Roadmap Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ranking Roadmap"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/primaryDark"
                android:fontFamily="@font/poppins_semibold"
                android:layout_marginBottom="16dp" />

            <!-- Rank Items -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Bronze -->
                <include layout="@layout/item_rank_roadmap"
                    android:id="@+id/rank_bronze" />

                <!-- Silver -->
                <include layout="@layout/item_rank_roadmap"
                    android:id="@+id/rank_silver" />

                <!-- Gold -->
                <include layout="@layout/item_rank_roadmap"
                    android:id="@+id/rank_gold" />

                <!-- Diamond -->
                <include layout="@layout/item_rank_roadmap"
                    android:id="@+id/rank_diamond" />

                <!-- Platinum -->
                <include layout="@layout/item_rank_roadmap"
                    android:id="@+id/rank_platinum" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</androidx.cardview.widget.CardView>
