<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:startDestination="@id/mapFragment">

    <fragment
        android:id="@+id/mapFragment"
        android:name="com.visiboard.app.ui.map.MapFragment"
        android:label="Map">
        <argument
            android:name="note_id"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <argument
            android:name="latitude"
            app:argType="float"
            android:defaultValue="0" />
        <argument
            android:name="longitude"
            app:argType="float"
            android:defaultValue="0" />
    </fragment>

    <fragment
        android:id="@+id/captureFragment"
        android:name="com.visiboard.app.ui.capture.CaptureFragment"
        android:label="Capture">
        <action
            android:id="@+id/action_captureFragment_to_capturePreviewFragment"
            app:destination="@id/capturePreviewFragment"
            app:enterAnim="@android:anim/fade_in"
            app:exitAnim="@android:anim/fade_out"
            app:popEnterAnim="@android:anim/fade_in"
            app:popExitAnim="@android:anim/fade_out"/>
    </fragment>

    <fragment
        android:id="@+id/capturePreviewFragment"
        android:name="com.visiboard.app.ui.capture.CapturePreviewFragment"
        android:label="Preview"/>

    <fragment
        android:id="@+id/feedFragment"
        android:name="com.visiboard.app.ui.feed.FeedFragment"
        android:label="Feed" />

    <fragment
        android:id="@+id/connectFragment"
        android:name="com.visiboard.app.ui.connect.ConnectFragment"
        android:label="Connect" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.visiboard.app.ui.profile.ProfileFragment"
        android:label="Profile">
        <action
            android:id="@+id/action_profile_to_favouriteSelection"
            app:destination="@id/favouriteSelectionFragment"
            app:enterAnim="@android:anim/fade_in"
            app:exitAnim="@android:anim/fade_out"
            app:popEnterAnim="@android:anim/fade_in"
            app:popExitAnim="@android:anim/fade_out"/>
    </fragment>

    <fragment
        android:id="@+id/favouriteSelectionFragment"
        android:name="com.visiboard.app.ui.profile.FavouriteSelectionFragment"
        android:label="Select Favourites"/>

    <fragment
        android:id="@+id/userProfileFragment"
        android:name="com.visiboard.app.ui.profile.UserProfileFragment"
        android:label="User Profile">
        <argument
            android:name="userId"
            app:argType="string" />
    </fragment>
</navigation>
